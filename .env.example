# bag-of-holding-mcp — copy to .env and fill in. Never commit .env.

# ---- Tenancy / auth ---------------------------------------------------------
# THE required setting. Comma-separated SHA-256 hashes of the tokens you have
# issued; anything not listed gets a 404. bin/http.js refuses to start with
# this empty, so a half-configured deploy fails closed rather than serving
# every campaign to whoever finds the URL.
#
# Mint a token and get its hash (keep the token, paste the hash here):
#   tok=$(openssl rand -hex 32); echo "token: $tok"; \
#     printf '%s' "$tok" | sha256sum | cut -d' ' -f1
#
# One token per table. The token IS the tenant: it hashes to that table's
# storage namespace, and it travels in the connector URL
# (https://<host>/mcp/<token>), so treat a leaked URL as a leaked campaign
# and rotate it. URLs land in access logs far more readily than headers do.
BOH_MEMORY_TOKEN_HASHES=

# ---- Semantic memory --------------------------------------------------------
# Both sidecars are wired over the internal Docker network in
# docker-compose.yml, so there is nothing to point at by hand. These only
# tune them.
#
# Raise this if the embeddings container is OOMKilled on first model load
# (`docker inspect bag-of-holding-embeddings --format '{{.State.OOMKilled}}'`).
# Qwen3-Embedding-0.6B wants roughly 3-4 GB resident; 6g leaves headroom for
# batches. Lower it only if the box is tight — the failure mode is a container
# that dies on boot, after which search silently stays lexical-only.
EMBEDDINGS_MEM_LIMIT=8g
EMBEDDINGS_CPUS=2.0
# The batch ceiling TEI serves with. Its own default is 16384, sized for a
# throughput service; warmup runs inference over a batch that large before the
# container serves anything, so it drives both peak memory and how long you
# wait for readiness. 4096 suits a single table writing short memories.
# If you raise it, raise MAX_BATCH in src/memory/embedder.js too — a request
# bigger than this ceiling is rejected, not split.
EMBEDDINGS_MAX_BATCH_TOKENS=4096
BOH_EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B
# Matryoshka truncation of the 1024-dim output. Changing this after go-live
# needs a NEW BOH_QDRANT_COLLECTION: Qdrant fixes vector size at collection
# creation and will 400 every upsert against a mismatched one.
BOH_EMBEDDINGS_DIM=256
BOH_QDRANT_COLLECTION=boh-memory
# Qdrant runs WITHOUT an api key, and this variable is not wired into the
# compose file at all. That is deliberate, not an oversight: an empty key is
# worse than no key. `${QDRANT_API_KEY:-}` always *defines* the variable, and
# Qdrant reads a defined-but-empty api_key as "auth is on", then rejects every
# request with 401 — including from the server that shares the value. Blanking
# this line would not have turned it off; only removing the variable does.
#
# It costs nothing to run without: qdrant has no gateway and no published
# ports, so 6333 is unreachable from off-host.
#
# To enable one, uncomment the two commented lines in docker-compose.yml (the
# qdrant service AND the mcp service — they must move together) and set a
# fresh value here, e.g. `openssl rand -hex 32`. Do not reuse another
# system's secret.
# QDRANT_API_KEY=

# ---- Deploy -----------------------------------------------------------------
# Services docker/deploy.sh leaves running through a code deploy. Both are
# stateful and slow to restart — Qdrant reopens its storage, and the embedding
# server reloads multi-GB weights — so cycling them for an app-only change
# would take semantic search down for a minute on every push.
DEPLOY_KEEP_SERVICES=qdrant embeddings
