# bag-of-holding-mcp — copy to .env and fill in. Never commit .env.

# ---- Tenancy / auth ---------------------------------------------------------
# THE required setting. Comma-separated SHA-256 hashes of the tokens you have
# issued; anything not listed gets a 404. bin/http.js refuses to start with
# this empty, so a half-configured deploy fails closed rather than serving
# every campaign to whoever finds the URL.
#
# Mint a token and get its hash (keep the token, paste the hash here):
#   tok=$(openssl rand -hex 32); echo "token: $tok"; \
#     printf '%s' "$tok" | sha256sum | cut -d' ' -f1
#
# One token per table. The token IS the tenant: it hashes to that table's
# storage namespace, and it travels in the connector URL
# (https://<host>/mcp/<token>), so treat a leaked URL as a leaked campaign
# and rotate it. URLs land in access logs far more readily than headers do.
BOH_MEMORY_TOKEN_HASHES=

# The other half of the allowlist: a JSON file some other process (the admin
# panel) writes, re-read within ~2s of changing so tenants can be added,
# retiered, suspended or revoked without a redeploy. Unioned with the hashes
# above — an env token stays valid whatever the file says, which is what makes
# the variable a break-glass path rather than one more thing to get wrong.
#
#   { "version": 1,
#     "tenants": { "<sha256 of token>": { "tier": "free", "status": "active" } } }
#
# Leave it unset to keep the env var as the only source. The file is mounted
# read-only into this container; the panel is the only writer.
#
# Failure posture: corrupt at startup refuses to boot (exit 2); corrupt or
# missing later keeps the last good copy and warns. Only the exact status
# "active" authorises — a typo suspends, deliberately.
BOH_TENANT_REGISTRY=/registry/tenants.json

# ---- Inference relay --------------------------------------------------------
# Optional, and the one setting here that spends money on someone else's turn.
#
# A tenant token normally buys storage: campaigns, worlds, and an image tier.
# It buys no prose, because every host that wants prose holds a provider key of
# its own — true of a desktop MCP host, false of a browser game where the
# player has no key and you do. Set this and the token can pay for text too,
# through an OpenAI-compatible relay under the tenant path:
#
#   POST https://<host>/mcp/<token>/v1/chat/completions
#   GET  https://<host>/mcp/<token>/v1/models
#   GET  https://<host>/mcp/<token>/v1/status     ← what a setup wizard reads
#
# A browser host points its base URL at `/mcp/<token>/v1` and needs no other
# change: it is the same contract the provider serves. With this unset, /status
# answers `relayEnabled: false` and the other two return 503, so a host can
# fall back to asking the player for their own key instead of failing a turn.
#
# What protects the account: the tier (from the registry above) names which
# model ids a tenant may reach and how many tokens it may spend per rolling
# window — free 150k/day, patron 2M/day, studio 10M/day. Free tenants reach
# only `:free` model ids and cannot generate images on your key at all.
# BOH_LLM_API_KEY=
# Provider base URL. Anything OpenAI-compatible; the default is OpenRouter.
# Point it at a self-hosted gateway to keep inference on your own hardware.
# BOH_LLM_URL=https://openrouter.ai/api/v1
# Tier for tenants the registry says nothing about (env-allowlist tokens, or a
# single-tenant deployment with no registry). Never an upgrade for a tenant the
# registry HAS priced — the file wins.
BOH_LLM_TIER=free
# Extra model ids a tenant may ask for, comma-separated. Only ever ADDS (for a
# private or self-hosted catalog); it cannot lift a free tenant onto a paid
# model, because that decision belongs to the registry.
# BOH_LLM_MODEL_ALLOW=
# How this deployment identifies itself to the provider. Not the player's
# origin — forwarding that would put one table's hostname on another's bill.
# BOH_LLM_APP_TITLE=bag-of-holding-mcp

# ---- Semantic memory --------------------------------------------------------
# Both sidecars are wired over the internal Docker network in
# docker-compose.yml, so there is nothing to point at by hand. These only
# tune them.
#
# Raise this if the embeddings container is OOMKilled on first model load
# (`docker inspect bag-of-holding-embeddings --format '{{.State.OOMKilled}}'`).
# Qwen3-Embedding-0.6B wants roughly 3-4 GB resident; 6g leaves headroom for
# batches. Lower it only if the box is tight — the failure mode is a container
# that dies on boot, after which search silently stays lexical-only.
EMBEDDINGS_MEM_LIMIT=8g
EMBEDDINGS_CPUS=2.0
# The batch ceiling TEI serves with. Its own default is 16384, sized for a
# throughput service; warmup runs inference over a batch that large before the
# container serves anything, so it drives both peak memory and how long you
# wait for readiness. 4096 suits a single table writing short memories.
# If you raise it, raise MAX_BATCH in src/memory/embedder.js too — a request
# bigger than this ceiling is rejected, not split.
EMBEDDINGS_MAX_BATCH_TOKENS=4096
BOH_EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B
# Matryoshka truncation of the 1024-dim output. Changing this after go-live
# needs a NEW BOH_QDRANT_COLLECTION: Qdrant fixes vector size at collection
# creation and will 400 every upsert against a mismatched one.
BOH_EMBEDDINGS_DIM=256
BOH_QDRANT_COLLECTION=boh-memory
# Qdrant runs WITHOUT an api key, and this variable is not wired into the
# compose file at all. That is deliberate, not an oversight: an empty key is
# worse than no key. `${QDRANT_API_KEY:-}` always *defines* the variable, and
# Qdrant reads a defined-but-empty api_key as "auth is on", then rejects every
# request with 401 — including from the server that shares the value. Blanking
# this line would not have turned it off; only removing the variable does.
#
# It costs nothing to run without: qdrant has no gateway and no published
# ports, so 6333 is unreachable from off-host.
#
# To enable one, uncomment the two commented lines in docker-compose.yml (the
# qdrant service AND the mcp service — they must move together) and set a
# fresh value here, e.g. `openssl rand -hex 32`. Do not reuse another
# system's secret.
# QDRANT_API_KEY=

# ---- World shelf --------------------------------------------------------------
# Baked world cartridges: the templates a campaign plays over. One immutable
# base on a shelf every tenant shares, plus a per-campaign patch ledger in that
# tenant's own namespace — so two tables can run the same world and diverge
# completely without touching each other or the cartridge.
#
# Seeds to bake into the boh-worlds volume on first deploy, comma-separated.
# The worlds-seed one-shot bakes each ONE TIME and skips anything already
# there; after the first deploy it should report "already on the shelf" every
# time. That skip is load-bearing, not laziness: campaigns pin a cartridge by
# digest, so re-minting a seed under a running campaign would strand it.
#
# Empty (the default) is a valid deployment and NOT a misconfiguration — you
# get an empty catalog, world_catalog says so cleanly, and you manage the shelf
# yourself with the client's scripts/bake-world.js. Pick any numbers you like;
# each is a different world.
BOH_SEED_WORLDS=1234

# Where the shelf lives inside the container. The compose file mounts the
# boh-worlds volume here read-only, so leave this alone unless you are mounting
# cartridges from somewhere else.
# BOH_WORLDS_DIR=/worlds

# NOTE: the shelf is read ONCE, at server start. Unlike BOH_TENANT_REGISTRY it
# does not hot-reload, so a cartridge added to the volume while the server is
# up stays invisible until `docker compose restart mcp`.

# ---- Browser pages ------------------------------------------------------------
# The static UI surface: the client home at `/`, the world atlas at `/atlas`.
# Served on its own port from the pages that ship inside
# @zeeuw/bag-of-holding-client. It has no auth because it has nothing to
# protect — static files only, no token, no store, no shelf. The pages bake a
# world in the browser; showing a REAL campaign is the host's job, through its
# own authenticated proxy calling world_atlas.
#
# The port is set in docker-compose.yml (8099). Unset it there to switch the
# surface off entirely.
#
# Set this only when the reverse proxy forwards a path prefix instead of
# stripping it — nginx-proxy-manager's Custom Locations DO forward it, so a
# location of `/client` needs `BOH_UI_BASE_PATH=/client` here or every asset
# 404s. Leave empty when the pages sit at the root of their own hostname.
# BOH_UI_BASE_PATH=

# ---- Deploy -----------------------------------------------------------------
# Services docker/deploy.sh leaves running through a code deploy. Both are
# stateful and slow to restart — Qdrant reopens its storage, and the embedding
# server reloads multi-GB weights — so cycling them for an app-only change
# would take semantic search down for a minute on every push.
DEPLOY_KEEP_SERVICES=qdrant embeddings
